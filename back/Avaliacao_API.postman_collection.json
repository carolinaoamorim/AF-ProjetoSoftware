{
  "info": {
    "name": "Avaliacao API",
    "description": "API de avaliações. Defina a variável {{token}} com um access token do Auth0.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Listar avaliações (ADMIN e USER)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/avaliacoes", "host": ["{{baseUrl}}"], "path": ["avaliacoes"] }
      },
      "response": []
    },
    {
      "name": "Cadastrar avaliação (ADMIN)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailAvaliador\": \"professor@insper.edu.br\",\n  \"emailAvaliado\": \"aluno@al.insper.edu.br\",\n  \"comentarios\": \"Ótima apresentação do projeto.\",\n  \"nota\": 9.5\n}"
        },
        "url": { "raw": "{{baseUrl}}/avaliacoes", "host": ["{{baseUrl}}"], "path": ["avaliacoes"] }
      },
      "response": []
    }
  ]
}
